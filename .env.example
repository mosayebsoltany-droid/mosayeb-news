# Copy to .env locally. Never commit the real file.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BROKER_JWT_SECRET=
BROKER_ALGORITHM=HS256
BROKER_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Omit this setting to keep the existing project-relative SQLite file.
# BROKER_DATABASE_URL=sqlite:////absolute/path/to/broker.db
# PostgreSQL, empty database initialized with: alembic upgrade head
# BROKER_DATABASE_URL=postgresql+psycopg://broker:URL_ENCODED_PASSWORD@127.0.0.1:5432/broker
BROKER_MOCK_REGISTRY_URL=http://mock-registry/submit
BROKER_REGISTRY_TIMEOUT_SECONDS=5
BROKER_MOCK_FAILURE_RATE=0.2
BROKER_ALLOWED_HOSTS=localhost,127.0.0.1
BROKER_CORS_ORIGINS=
BROKER_ENABLE_DEMO=true
BROKER_AUTO_CREATE_TABLES=true

# Optional isolated PostgreSQL Compose stack (URL-safe password only)
# BROKER_POSTGRES_PASSWORD=
# BROKER_POSTGRES_PORT=8002
