{
  "name": "Real Estate Broker System",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postStartCommand": "docker compose up --build --detach --wait --wait-timeout 120",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Broker API",
      "onAutoForward": "notify"
    }
  }
}
